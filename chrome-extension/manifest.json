{
  "manifest_version": 3,
  "name": "StormGet (RustIDM) Integration Module v2.4",
  "version": "2.4.5",
  "description": "اعتراض التحميلات تلقائياً، إدارة حالة الاتصال بمحرك StormGet، الإيقاف المؤقت الموقوت، حظر المواقع الدائم بدعم النطاقات الفرعية، واكتشاف جودات الفيديو (HLS/DASH/YouTube/MP4)",
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "media-hook.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "StormGet v2.4 — لوحة التحكم والاتصال بالمحرك",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@rustidm.local",
      "strict_min_version": "109.0"
    }
  }
}
