{
"manifest_version": 3,
"name": "RustIDM Integration Module",
"version": "1.2.0",
"description": "اعتراض التحميلات واكتشاف جودات الفيديو الحقيقية (HLS/DASH/YouTube/MP4) على غرار Internet Download Manager",
"permissions": [
"downloads",
"webRequest",
"cookies",
"tabs",
"storage",
"nativeMessaging"
],
"host_permissions": [
"<all_urls>"
],
"background": {
"service_worker": "background.js"
},
"content_scripts": [
{
"matches": ["<all_urls>"],
"js": ["content.js"],
"run_at": "document_idle",
"all_frames": true
}
],
"action": {
"default_title": "RustIDM Integration Module"
}
}