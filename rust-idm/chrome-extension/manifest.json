{
  "manifest_version": 3,
  "name": "RustIDM Integration Module",
  "version": "1.1.0",
  "description": "إضافة التكامل الرسمية لمحرك RustIDM عبر Native Messaging و IPC المحلي لاعتراض التحميلات والتقاط بث HLS/DASH وتحديث الروابط",
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:16888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
