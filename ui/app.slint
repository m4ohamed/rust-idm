// StormGet v2.3.4 (RustIDM سابقاً) — واجهة سطح المكتب الكاملة المبنية بـ Slint
// تدعم العربية أصلياً (تشكيل الحروف و BiDi ومحاذاة RTL دون الحاجة لعكس الحروف يدوياً)
// وتوفر نوافذ نظام تشغيل مستقلة حقيقية (MainWindow, AddDownloadWindow, DetailsWindow, SchedulerWindow, SettingsWindow, DiagnosticsWindow)
// مع قوائم سياقية ذكية (Right-Click)، وشريط قوائم قياسي، وشريط أدوات متكامل، وحفظ/استعادة موضع وحجم النوافذ.

import { Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct SlintDownloadRow {
    task-id: string,
    filename: string,
    category: string,
    queue-name: string,
    size-text: string,
    downloaded-text: string,
    status-text: string,
    progress-pct: float,
    indeterminate: bool,
    speed-text: string,
    eta-text: string,
    segments-count: int,
    active-conns: int,
    created-at-text: string,
    save-dir-text: string,
    sha256: string,
    crc32: string,
    state-code: int, // 0: Downloading, 1: Paused/Queued, 2: Completed, 3: Failed/Expired, 4: Cancelled, 5: Verifying/Assembling
    file-exists: bool,
    is-expired: bool,
}

export struct SlintQueueRow {
    name: string,
    mode-text: string,
    start-time: string,
    stop-time: string,
    days-text: string,
    tasks-count: int,
    max-concurrent: int,
    speed-limit-kbps: int,
}

export struct SlintSegmentRow {
    seg-id: int,
    downloaded-text: string,
    speed-text: string,
    status-text: string,
    progress-ratio: float,
}

export struct SlintZipEntryRow {
    filename: string,
    compressed-size: string,
    uncompressed-size: string,
    crc32-hex: string,
}

// ============================================================================
// 1. نافذة إضافة تنزيل جديد المستقلة (Independent OS Window: AddDownloadWindow)
// ============================================================================
export component AddDownloadWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.arabic ? "StormGet — إضافة تنزيل جديد" : "StormGet — Add New Download";
    preferred-width: 620px;
    preferred-height: 430px;
    min-width: 540px;
    min-height: 360px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in-out property <string> url-input: "";
    in-out property <string> filename-input: "";
    in-out property <string> save-dir-input: "";
    in-out property <string> category-text: "عام (General)";
    in-out property <string> queue-input: "main";
    in-out property <string> description-input: "";
    in-out property <string> sha256-input: "";
    in-out property <string> md5-input: "";
    in-out property <string> crc32-input: "";
    in-out property <string> referer-input: "";
    in-out property <string> cookies-input: "";
    in-out property <string> mirrors-input: "";
    in-out property <bool> show-advanced: false;

    in property <string> probed-size-text: "الحجم: لم يُفحص بعد";
    in property <string> probed-resumable-text: "";
    in property <string> probed-host-text: "";
    in property <string> validation-message: "";
    in property <bool> probe-busy: false;

    callback paste-clipboard();
    callback probe-url(string, string, string);
    callback start-download-now();
    callback add-to-queue-later();
    callback cancel-window();
    callback open-save-dir(string);

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.arabic ? "➕ إضافة تنزيل جديد (فحص HTTP Range + متعدد الاتصالات)" : "➕ Add New Download";
                color: root.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.probed-host-text;
                color: #40a8f5;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "https://example.com/archive.zip";
                text <=> root.url-input;
            }
            Button {
                text: root.arabic ? "📋 لصق" : "📋 Paste";
                clicked => { root.paste-clipboard(); }
            }
            Button {
                text: root.probe-busy ? (root.arabic ? "⏳ جاري الفحص..." : "⏳ Probing...") : (root.arabic ? "🔍 فحص الملف" : "🔍 Probe URL");
                enabled: !root.probe-busy && root.url-input != "";
                clicked => { root.probe-url(root.url-input, root.referer-input, root.cookies-input); }
            }
        }

        if root.validation-message != "": Text {
            text: root.validation-message;
            color: #f0b034;
            font-size: 11px;
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.arabic ? "اسم الملف:" : "File Name:";
                color: root.text-primary;
                width: 85px;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: root.arabic ? "يُستخرج تلقائياً من الخادم أو الرابط" : "Auto-extracted from server or URL";
                text <=> root.filename-input;
            }
            Text {
                text: root.probed-size-text + root.probed-resumable-text;
                color: #2ec46c;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.arabic ? "مجلد الحفظ:" : "Save Folder:";
                color: root.text-primary;
                width: 85px;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.save-dir-input;
            }
            Button {
                text: root.arabic ? "📁 فتح" : "📁 Open";
                clicked => { root.open-save-dir(root.save-dir-input); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.arabic ? "الطابور:" : "Queue:";
                color: root.text-primary;
                width: 85px;
                vertical-alignment: center;
            }
            LineEdit {
                width: 120px;
                text <=> root.queue-input;
            }
            Text {
                text: root.arabic ? "الوصف:" : "Notes:";
                color: root.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.description-input;
            }
            CheckBox {
                text: root.arabic ? "خيارات متقدمة" : "Advanced";
                checked <=> root.show-advanced;
            }
        }

        if root.show-advanced: Rectangle {
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;
            border-radius: 4px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "SHA-256 المتوقع (اختياري)";
                        text <=> root.sha256-input;
                    }
                    LineEdit {
                        width: 160px;
                        placeholder-text: "MD5 (اختياري)";
                        text <=> root.md5-input;
                    }
                    LineEdit {
                        width: 120px;
                        placeholder-text: "CRC32";
                        text <=> root.crc32-input;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Referer URL (اختياري)";
                        text <=> root.referer-input;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "روابط مرايا بديلة مفصولة بفاصلة ,";
                        text <=> root.mirrors-input;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 10px;
            Button {
                text: root.arabic ? "▶ بدء التنزيل الآن" : "▶ Start Download Now";
                primary: true;
                enabled: root.url-input != "";
                clicked => { root.start-download-now(); }
            }
            Button {
                text: root.arabic ? "⏳ إضافة إلى قائمة الانتظار" : "⏳ Add to Queue (Later)";
                enabled: root.url-input != "";
                clicked => { root.add-to-queue-later(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.arabic ? "إلغاء" : "Cancel";
                clicked => { root.cancel-window(); }
            }
        }
    }
}

// ============================================================================
// 2. نافذة تفاصيل التنزيل المستقلة (Independent OS Window: DetailsWindow)
// ============================================================================
export component DetailsWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.window-title;
    preferred-width: 680px;
    preferred-height: 540px;
    min-width: 560px;
    min-height: 420px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in property <string> window-title: "StormGet — تفاصيل التنزيل";
    in property <string> task-id: "";
    in property <string> filename: "—";
    in property <string> url: "—";
    in property <string> local-path: "—";
    in property <string> status-text: "—";
    in property <string> total-size-text: "—";
    in property <string> downloaded-text: "—";
    in property <float> progress-ratio: 0.0;
    in property <string> speed-text: "0 KB/s";
    in property <string> eta-text: "—";
    in property <string> host-text: "—";
    in property <string> resumable-text: "—";
    in property <string> etag-text: "—";
    in property <string> last-modified-text: "—";
    in property <string> created-at-text: "—";
    in property <string> updated-at-text: "—";
    in property <string> error-text: "";
    in property <string> sha256-text: "لم يُحسب بعد";
    in property <string> md5-text: "لم يُحسب بعد";
    in property <string> crc32-text: "لم يُحسب بعد";
    in property <string> integrity-verdict: "لم يُنفذ التحقق بعد";
    in property <string> logs-text: "";
    in property <[SlintSegmentRow]> segments: [];
    in-out property <int> active-tab: 0; // 0: General, 1: Progress & Segments, 2: Connection, 3: Logs, 4: Integrity

    callback pause-task(string);
    callback resume-task(string);
    callback cancel-task(string);
    callback reverify-task(string);
    callback open-file(string);
    callback open-folder(string);
    callback preview-task(string);
    callback diagnose-task(string);
    callback close-window();

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: root.filename;
            color: root.text-primary;
            font-size: 16px;
            font-weight: 700;
            overflow: elide;
        }

        // شريط التبويبات الـ 5 القياسية (General, Progress, Connection, Logs, Integrity)
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: root.arabic ? "عام (General)" : "General";
                primary: root.active-tab == 0;
                clicked => { root.active-tab = 0; }
            }
            Button {
                text: root.arabic ? "التقدم والمقاطع (Progress)" : "Progress & Segments";
                primary: root.active-tab == 1;
                clicked => { root.active-tab = 1; }
            }
            Button {
                text: root.arabic ? "الاتصال (Connection)" : "Connection";
                primary: root.active-tab == 2;
                clicked => { root.active-tab = 2; }
            }
            Button {
                text: root.arabic ? "السجل (Logs)" : "Logs";
                primary: root.active-tab == 3;
                clicked => { root.active-tab = 3; }
            }
            Button {
                text: root.arabic ? "سلامة الملف (Integrity)" : "Integrity";
                primary: root.active-tab == 4;
                clicked => { root.active-tab = 4; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;
            border-radius: 4px;

            // تبويب 0: General
            if root.active-tab == 0: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text { text: (root.arabic ? "الحالة الحالية: " : "Status: ") + root.status-text; color: #40a8f5; font-weight: 700; }
                Text { text: (root.arabic ? "رابط المصدر: " : "Source URL: ") + root.url; color: root.text-secondary; overflow: elide; }
                Text { text: (root.arabic ? "المسار المحلي: " : "Local Path: ") + root.local-path; color: root.text-primary; overflow: elide; }
                Text { text: (root.arabic ? "الحجم الإجمالي: " : "Total Size: ") + root.total-size-text + (root.arabic ? "  |  المنزّل: " : "  |  Downloaded: ") + root.downloaded-text; color: root.text-primary; }
                Text { text: (root.arabic ? "تاريخ الإضافة: " : "Added: ") + root.created-at-text + (root.arabic ? "  |  آخر تحديث: " : "  |  Updated: ") + root.updated-at-text; color: root.text-secondary; }
                if root.error-text != "": Text {
                    text: (root.arabic ? "⚠ سبب التوقف / الفشل: " : "⚠ Error: ") + root.error-text;
                    color: #ee5252;
                    font-weight: 700;
                }
            }

            // تبويب 1: Progress & Segments
            if root.active-tab == 1: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: (root.arabic ? "السرعة الحالية: " : "Speed: ") + root.speed-text + (root.arabic ? "  |  الوقت المتبقي: " : "  |  ETA: ") + root.eta-text;
                    color: root.text-primary;
                    font-weight: 700;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for seg in root.segments: HorizontalLayout {
                            spacing: 10px;
                            Text { width: 50px; text: "#" + seg.seg-id; color: root.text-primary; }
                            Text { width: 120px; text: seg.downloaded-text; color: root.text-secondary; }
                            Text { width: 110px; text: seg.speed-text; color: #40a8f5; }
                            Text { horizontal-stretch: 1; text: seg.status-text; color: root.text-primary; }
                        }
                    }
                }
            }

            // تبويب 2: Connection
            if root.active-tab == 2: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text { text: (root.arabic ? "المضيف (Host): " : "Host: ") + root.host-text; color: root.text-primary; font-weight: 700; }
                Text { text: (root.arabic ? "دعم الاستئناف والتقسيم (HTTP Range): " : "Resume Support: ") + root.resumable-text; color: #2ec46c; }
                Text { text: "ETag: " + root.etag-text; color: root.text-secondary; }
                Text { text: "Last-Modified: " + root.last-modified-text; color: root.text-secondary; }
            }

            // تبويب 3: Logs (Redacted)
            if root.active-tab == 3: VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: root.arabic ? "سجل الأحداث والاتصالات (الأسرار والكوكيز محجوبة تلقائياً):" : "Connection & Error Logs (Secrets Redacted):";
                    color: root.text-primary;
                    font-weight: 700;
                }
                ScrollView {
                    vertical-stretch: 1;
                    Text {
                        text: root.logs-text;
                        color: root.text-secondary;
                        font-size: 11px;
                    }
                }
            }

            // تبويب 4: Integrity
            if root.active-tab == 4: VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "SHA-256: " + root.sha256-text; color: root.text-primary; font-size: 12px; overflow: elide; }
                Text { text: "MD5:     " + root.md5-text; color: root.text-primary; font-size: 12px; }
                Text { text: "CRC32:   " + root.crc32-text; color: root.text-primary; font-size: 12px; }
                Text { text: (root.arabic ? "نتيجة المقارنة والتحقق: " : "Verification Status: ") + root.integrity-verdict; color: #2ec46c; font-weight: 700; }
                HorizontalLayout {
                    Button {
                        text: root.arabic ? "🔍 حساب وإعادة فحص البصمات الآن" : "🔍 Re-verify Checksums Now";
                        clicked => { root.reverify-task(root.task-id); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // شريط التقدم الكلي
        Rectangle {
            height: 16px;
            border-radius: 4px;
            background: root.dark-mode ? #0f172a : #e2e8f0;
            border-width: 1px;
            border-color: root.border-col;
            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width * clamp(root.progress-ratio, 0.0, 1.0);
                border-radius: 4px;
                background: #2ec46c;
            }
        }

        // أزرار الإجراءات السفلية (إغلاق النافذة لا يلغي التنزيل)
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.arabic ? "▶ استئناف" : "▶ Resume";
                clicked => { root.resume-task(root.task-id); }
            }
            Button {
                text: root.arabic ? "⏸ إيقاف مؤقت" : "⏸ Pause";
                clicked => { root.pause-task(root.task-id); }
            }
            Button {
                text: root.arabic ? "⏹ إلغاء المهمة" : "⏹ Cancel Task";
                clicked => { root.cancel-task(root.task-id); }
            }
            Button {
                text: root.arabic ? "📂 فتح الملف" : "📂 Open File";
                clicked => { root.open-file(root.task-id); }
            }
            Button {
                text: root.arabic ? "📁 فتح المجلد" : "📁 Open Folder";
                clicked => { root.open-folder(root.task-id); }
            }
            Button {
                text: root.arabic ? "🎬 معاينة حية" : "🎬 Preview";
                clicked => { root.preview-task(root.task-id); }
            }
            Button {
                text: root.arabic ? "🩺 تشخيص العطل" : "🩺 Doctor";
                clicked => { root.diagnose-task(root.task-id); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.arabic ? "إغلاق النافذة" : "Close Window";
                clicked => { root.close-window(); }
            }
        }
    }
}

// ============================================================================
// 3. نافذة الجدولة والطوابير المستقلة (Independent OS Window: SchedulerWindow)
// ============================================================================
export component SchedulerWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.arabic ? "StormGet — إدارة الجدولة والطوابير" : "StormGet — Scheduler & Queue Manager";
    preferred-width: 740px;
    preferred-height: 520px;
    min-width: 620px;
    min-height: 420px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in property <[SlintQueueRow]> queues: [];
    in-out property <string> selected-queue-name: "main";
    in-out property <string> new-queue-name: "";
    in-out property <int> schedule-mode-code: 0; // 0: Disabled, 1: Daily, 2: Once
    in-out property <string> start-time-input: "22:00";
    in-out property <string> stop-time-input: "06:00";
    in-out property <string> once-start-input: "2026-10-27 01:00";
    in-out property <string> max-conns-input: "4";
    in-out property <string> speed-limit-input: "0";
    in property <string> status-feedback: "";

    callback create-queue(string);
    callback delete-queue(string);
    callback start-queue-now(string);
    callback stop-queue-now(string);
    callback save-schedule(string, int, string, string, string, string, string);
    callback close-window();

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: root.arabic ? "⏰ إدارة الجدولة الزمنية والطوابير (تعمل أثناء تشغيل البرنامج وتدعم العبور بعد منتصف الليل)" : "⏰ Scheduler & Queue Manager";
            color: root.text-primary;
            font-size: 15px;
            font-weight: 700;
        }

        Rectangle {
            height: 165px;
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;
            border-radius: 4px;
            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    for q in root.queues: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: q.name == root.selected-queue-name ? (root.dark-mode ? #1a4e8a : #cde8ff) : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Button {
                                text: q.name;
                                clicked => {
                                    root.selected-queue-name = q.name;
                                    root.start-time-input = q.start-time;
                                    root.stop-time-input = q.stop-time;
                                }
                            }
                            Text { width: 130px; text: q.mode-text; color: #2ec46c; vertical-alignment: center; }
                            Text { width: 120px; text: q.start-time + " -> " + q.stop-time; color: root.text-primary; vertical-alignment: center; }
                            Text { width: 80px; text: q.tasks-count + " مهام"; color: root.text-secondary; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: root.arabic ? "▶ تشغيل الآن" : "▶ Run Now";
                                clicked => { root.start-queue-now(q.name); }
                            }
                            Button {
                                text: root.arabic ? "⏸ إيقاف" : "⏸ Stop";
                                clicked => { root.stop-queue-now(q.name); }
                            }
                            if q.name != "main": Button {
                                text: "🗑";
                                clicked => { root.delete-queue(q.name); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                width: 220px;
                placeholder-text: root.arabic ? "اسم طابور جديد (مثال: night)" : "New queue name";
                text <=> root.new-queue-name;
            }
            Button {
                text: root.arabic ? "➕ إنشاء طابور جديد" : "➕ Create Queue";
                enabled: root.new-queue-name != "";
                clicked => {
                    root.create-queue(root.new-queue-name);
                    root.new-queue-name = "";
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: (root.arabic ? "تحرير جدولة الطابور المحدد: " : "Editing Queue: ") + root.selected-queue-name;
                    color: #40a8f5;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.arabic ? "معطّلة (يدوي)" : "Disabled";
                        primary: root.schedule-mode-code == 0;
                        clicked => { root.schedule-mode-code = 0; }
                    }
                    Button {
                        text: root.arabic ? "يومية متكررة (HH:MM)" : "Daily Recurring";
                        primary: root.schedule-mode-code == 1;
                        clicked => { root.schedule-mode-code = 1; }
                    }
                    Button {
                        text: root.arabic ? "لمرة واحدة (YYYY-MM-DD HH:MM)" : "One-Time";
                        primary: root.schedule-mode-code == 2;
                        clicked => { root.schedule-mode-code = 2; }
                    }
                }

                if root.schedule-mode-code == 1: HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.arabic ? "وقت البدء (HH:MM):" : "Start (HH:MM):"; color: root.text-primary; vertical-alignment: center; }
                    LineEdit { width: 100px; text <=> root.start-time-input; }
                    Text { text: root.arabic ? "وقت الانتهاء (HH:MM):" : "Stop (HH:MM):"; color: root.text-primary; vertical-alignment: center; }
                    LineEdit { width: 100px; text <=> root.stop-time-input; }
                }

                if root.schedule-mode-code == 2: HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.arabic ? "تاريخ ووقت البدء:" : "Start Date/Time:"; color: root.text-primary; vertical-alignment: center; }
                    LineEdit { width: 180px; text <=> root.once-start-input; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.arabic ? "التنزيلات المتزامنة:" : "Max Concurrent:"; color: root.text-primary; vertical-alignment: center; }
                    LineEdit { width: 70px; text <=> root.max-conns-input; }
                    Text { text: root.arabic ? "حد السرعة (KB/s، 0=مفتوح):" : "Speed Limit (KB/s):"; color: root.text-primary; vertical-alignment: center; }
                    LineEdit { width: 90px; text <=> root.speed-limit-input; }
                }

                if root.status-feedback != "": Text {
                    text: root.status-feedback;
                    color: #2ec46c;
                    font-size: 12px;
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button {
                text: root.arabic ? "💾 حفظ وتطبيق الجدولة" : "💾 Save & Apply Schedule";
                primary: true;
                clicked => {
                    root.save-schedule(
                        root.selected-queue-name,
                        root.schedule-mode-code,
                        root.start-time-input,
                        root.stop-time-input,
                        root.once-start-input,
                        root.max-conns-input,
                        root.speed-limit-input
                    );
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.arabic ? "إغلاق" : "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}

// ============================================================================
// 4. نافذة الإعدادات المستقلة بـ 8 أقسام (Independent OS Window: SettingsWindow)
// ============================================================================
export component SettingsWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.arabic ? "StormGet — الإعدادات والتفضيلات" : "StormGet — Settings & Preferences";
    preferred-width: 780px;
    preferred-height: 540px;
    min-width: 660px;
    min-height: 440px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in-out property <int> active-section: 0; // 0: General, 1: Appearance, 2: Downloads, 3: Connections, 4: Browser, 5: Media, 6: Notifications, 7: Advanced
    in-out property <string> download-dir-input: "";
    in-out property <string> max-connections-input: "8";
    in-out property <string> speed-limit-input: "0";
    in-out property <string> min-split-kb-input: "512";
    in-out property <string> proxy-url-input: "";
    in-out property <string> user-agent-input: "";
    in-out property <string> extensions-input: "";
    in-out property <bool> auto-start-downloads: true;
    in-out property <bool> verify-checksums: true;
    in-out property <bool> confirm-destructive: true;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> notify-complete: true;
    in-out property <bool> notify-failure: true;
    in property <string> tools-status-summary: "yt-dlp: ✓ | FFmpeg: ✓";
    in property <string> save-feedback: "";

    callback save-all-settings();
    callback reset-ui-layout();
    callback reset-engine-defaults();
    callback update-media-tools();
    callback open-diagnostics();
    callback close-window();

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            // القائمة الجانبية للأقسام الـ 8
            Rectangle {
                width: 185px;
                background: root.panel-bg;
                border-width: 1px;
                border-color: root.border-col;
                border-radius: 4px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    Button { text: root.arabic ? "1. عام (General)" : "1. General"; primary: root.active-section == 0; clicked => { root.active-section = 0; } }
                    Button { text: root.arabic ? "2. المظهر (Appearance)" : "2. Appearance"; primary: root.active-section == 1; clicked => { root.active-section = 1; } }
                    Button { text: root.arabic ? "3. التنزيلات (Downloads)" : "3. Downloads"; primary: root.active-section == 2; clicked => { root.active-section = 2; } }
                    Button { text: root.arabic ? "4. الاتصالات (Connections)" : "4. Connections"; primary: root.active-section == 3; clicked => { root.active-section = 3; } }
                    Button { text: root.arabic ? "5. تكامل المتصفح (Browser)" : "5. Browser"; primary: root.active-section == 4; clicked => { root.active-section = 4; } }
                    Button { text: root.arabic ? "6. الوسائط (Media)" : "6. Media Tools"; primary: root.active-section == 5; clicked => { root.active-section = 5; } }
                    Button { text: root.arabic ? "7. الإشعارات (Notifications)" : "7. Notifications"; primary: root.active-section == 6; clicked => { root.active-section = 6; } }
                    Button { text: root.arabic ? "8. متقدم (Advanced)" : "8. Advanced"; primary: root.active-section == 7; clicked => { root.active-section = 7; } }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // محتوى القسم المحدد
            Rectangle {
                horizontal-stretch: 1;
                background: root.panel-bg;
                border-width: 1px;
                border-color: root.border-col;
                border-radius: 4px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    if root.active-section == 0: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "الإعدادات العامة وسلوك الإغلاق" : "General Settings"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        CheckBox { text: root.arabic ? "اللغة العربية وتشكيل RTL الأصلي" : "Arabic RTL Language"; checked <=> root.arabic; }
                        CheckBox { text: root.arabic ? "إبقاء البرنامج في الخلفية عند إغلاق النافذة" : "Minimize to background on close"; checked <=> root.minimize-to-tray; }
                        CheckBox { text: root.arabic ? "طلب تأكيد قبل العمليات المدمرة (الحذف / الإلغاء)" : "Confirm destructive actions"; checked <=> root.confirm-destructive; }
                    }

                    if root.active-section == 1: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "المظهر والهوية البصرية" : "Appearance & Theme"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        CheckBox { text: root.arabic ? "تفعيل الوضع الداكن الاحترافي (Dark Mode)" : "Enable Dark Mode"; checked <=> root.dark-mode; }
                    }

                    if root.active-section == 2: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "مجلد الحفظ وسلوك التنزيلات" : "Downloads & Storage"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        Text { text: root.arabic ? "مجلد التنزيل الافتراضي:" : "Default Download Folder:"; color: root.text-secondary; }
                        LineEdit { text <=> root.download-dir-input; }
                        CheckBox { text: root.arabic ? "بدء التنزيلات الملتقطة تلقائياً" : "Auto-start intercepted downloads"; checked <=> root.auto-start-downloads; }
                        CheckBox { text: root.arabic ? "التحقق التلقائي من البصمات الرقمية (SHA-256 / MD5 / CRC32)" : "Auto-verify checksums on completion"; checked <=> root.verify-checksums; }
                    }

                    if root.active-section == 3: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "إعدادات الاتصال والسرعة والوكيل" : "Connections & Speed Limit"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.arabic ? "أقصى اتصالات لكل ملف (1..32):" : "Max Connections (1..32):"; color: root.text-primary; vertical-alignment: center; }
                            LineEdit { width: 80px; text <=> root.max-connections-input; }
                            Text { text: root.arabic ? "حد السرعة (KB/s، 0=مفتوح):" : "Speed Limit (KB/s):"; color: root.text-primary; vertical-alignment: center; }
                            LineEdit { width: 100px; text <=> root.speed-limit-input; }
                        }
                        Text { text: root.arabic ? "عنوان خادم الوكيل (Proxy URL):" : "Proxy URL:"; color: root.text-secondary; }
                        LineEdit { placeholder-text: "http://127.0.0.1:8080"; text <=> root.proxy-url-input; }
                        Text { text: "User-Agent:"; color: root.text-secondary; }
                        LineEdit { text <=> root.user-agent-input; }
                    }

                    if root.active-section == 4: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "تكامل المتصفح (Chrome / Edge / Firefox)" : "Browser Integration"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        Text { text: root.arabic ? "● حالة خادم التحكم المحلي (127.0.0.1:16888): نشط ومحصّن أمنياً" : "● Local IPC Server (127.0.0.1:16888): Active & Hardened"; color: #2ec46c; font-weight: 700; }
                        Text { text: root.arabic ? "الامتدادات الملتقطة تلقائياً (مفصولة بفاصلة):" : "Intercepted File Extensions:"; color: root.text-secondary; }
                        LineEdit { text <=> root.extensions-input; }
                    }

                    if root.active-section == 5: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "أدوات الوسائط والبث (HLS AES-128 / DASH / yt-dlp / FFmpeg)" : "Media & Stream Tools"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        Text { text: root.tools-status-summary; color: #2ec46c; font-weight: 700; }
                        Button {
                            text: root.arabic ? "🔄 فحص وتحديث yt-dlp و FFmpeg الآن" : "🔄 Check & Update yt-dlp / FFmpeg";
                            clicked => { root.update-media-tools(); }
                        }
                    }

                    if root.active-section == 6: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "إعدادات الإشعارات والتنبيهات" : "Notifications"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        CheckBox { text: root.arabic ? "إشعار عند اكتمال التنزيل" : "Notify on download completion"; checked <=> root.notify-complete; }
                        CheckBox { text: root.arabic ? "إشعار عند فشل التنزيل أو انتهاء صلاحية الرابط" : "Notify on download failure"; checked <=> root.notify-failure; }
                    }

                    if root.active-section == 7: VerticalLayout {
                        spacing: 8px;
                        Text { text: root.arabic ? "التشخيص المتقدم وإعادة الضبط" : "Advanced & Diagnostics"; color: root.text-primary; font-size: 15px; font-weight: 700; }
                        Button {
                            text: root.arabic ? "🩺 فتح نافذة التشخيص وسجل الأحداث المنقح" : "🩺 Open Diagnostics & Activity Log";
                            clicked => { root.open-diagnostics(); }
                        }
                        Button {
                            text: root.arabic ? "↺ إعادة ضبط تخطيط الواجهة إلى الافتراضي" : "↺ Reset UI Layout to Defaults";
                            clicked => { root.reset-ui-layout(); }
                        }
                        Button {
                            text: root.arabic ? "⚠ إعادة ضبط إعدادات المحرك إلى القيم المصنعية" : "⚠ Reset Engine Settings to Defaults";
                            clicked => { root.reset-engine-defaults(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                    if root.save-feedback != "": Text {
                        text: root.save-feedback;
                        color: #2ec46c;
                        font-weight: 700;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button {
                text: root.arabic ? "💾 حفظ وتطبيق جميع الإعدادات" : "💾 Save & Apply Settings";
                primary: true;
                clicked => { root.save-all-settings(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.arabic ? "إغلاق" : "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}

// ============================================================================
// 5. نافذة التشخيص وسجل الأخطاء المستقلة (Independent OS Window: DiagnosticsWindow)
// ============================================================================
export component DiagnosticsWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.arabic ? "StormGet — معلومات التشخيص وسجل النشاط" : "StormGet — Diagnostics & Activity Log";
    preferred-width: 700px;
    preferred-height: 480px;
    min-width: 540px;
    min-height: 360px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in property <string> diagnostic-report: "";

    callback refresh-report();
    callback close-window();

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: root.arabic ? "🩺 التقرير التشخيصي المنقح (خالي من الكوكيز والرموز السرية)" : "🩺 Redacted Diagnostic Report";
                color: root.text-primary;
                font-size: 15px;
                font-weight: 700;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.arabic ? "🔄 تحديث" : "🔄 Refresh";
                clicked => { root.refresh-report(); }
            }
            Button {
                text: root.arabic ? "إغلاق" : "Close";
                clicked => { root.close-window(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;
            border-radius: 4px;
            ScrollView {
                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: root.diagnostic-report;
                        color: root.text-secondary;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}

// ============================================================================
// 6. النافذة الرئيسية لـ StormGet (MainWindow)
// ============================================================================
export component MainWindow inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.arabic ? "StormGet v2.3.4 — مدير التنزيلات المكتبي الاحترافي (واجهة Slint العربية الأصلية)" : "StormGet v2.3.4 — Professional Desktop Download Manager (Slint UI)";
    preferred-width: 1140px;
    preferred-height: 680px;
    min-width: 880px;
    min-height: 520px;
    background: root.dark-mode ? #14181f : #f8fafc;

    in-out property <bool> arabic: true;
    in-out property <bool> dark-mode: true;
    in-out property <bool> show-sidebar: true;
    in-out property <bool> show-toolbar: true;
    in-out property <bool> show-status-bar: true;
    in-out property <bool> show-bottom-inspector: true;
    in-out property <string> active-filter: "all";
    in-out property <string> search-text: "";
    in-out property <string> selected-task-id: "";
    in-out property <int> selected-state-code: -1;
    in-out property <bool> selected-file-exists: false;
    in-out property <string> status-banner: "جاهز — محرك StormGet نشط";
    in-out property <string> aggregate-speed-text: "0 KB/s";
    in-out property <int> active-count: 0;
    in-out property <int> queued-count: 0;
    in-out property <string> tools-badge-text: "yt-dlp: ✓ | FFmpeg: ✓";

    // بيانات الجدول والفاحص السفلي
    in property <[SlintDownloadRow]> downloads: [];
    in property <string> selected-filename: "—";
    in property <string> selected-url: "—";
    in property <string> selected-sha256: "—";
    in property <string> selected-md5: "—";
    in property <string> selected-crc32: "—";
    in property <float> selected-progress: 0.0;
    in property <string> selected-logs: "";

    // القائمة السياقية عند النقر بالزر الأيمن (Context Menu State)
    in-out property <bool> show-context-menu: false;
    in-out property <length> context-menu-x: 200px;
    in-out property <length> context-menu-y: 200px;
    in-out property <int> context-menu-mode: 0; // 0: Row, 1: Empty Space

    // حوار التأكيد قبل حذف الملف أو السجل (Confirmation Dialog)
    in-out property <bool> show-confirm-modal: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-message: "";
    in-out property <string> confirm-action-kind: ""; // "remove_record" | "delete_disk" | "clear_completed" | "cancel_task"
    in-out property <string> confirm-target-id: "";

    // نوافذ مساعدة سريعة (Batch / Remote ZIP)
    in-out property <bool> show-batch-modal: false;
    in-out property <string> batch-pattern-input: "https://cdn.example.com/part_[001-010].zip";
    in-out property <string> batch-step-input: "1";

    in-out property <bool> show-zip-modal: false;
    in-out property <string> zip-url-input: "";
    in property <[SlintZipEntryRow]> zip-entries: [];
    in property <string> zip-summary-text: "";

    // إشارات فتح النوافذ المستقلة والتفاعل مع المحرك
    callback open-add-window();
    callback open-details-window(string);
    callback open-scheduler-window();
    callback open-settings-window(int);
    callback open-diagnostics-window();
    callback open-default-downloads-folder();

    callback add-batch(string, string);
    callback inspect-remote-zip(string);
    callback control-task(string, string);
    callback redownload-task(string);
    callback stop-all-tasks();
    callback resume-all-tasks();
    callback delete-completed-tasks();
    callback remove-task(string, bool);
    callback reverify-checksum(string);
    callback update-external-tools();
    callback open-task-file(string);
    callback open-task-folder(string);
    callback copy-to-clipboard(string);
    in-out property <bool> game-mode-active: false;
    callback toggle-game-mode();
    callback preview-task(string);
    callback diagnose-task(string);
    callback filter-changed(string);
    callback select-task(string);
    callback persist-ui-preferences();

    property <color> panel-bg: root.dark-mode ? #1b2029 : #ffffff;
    property <color> header-bg: root.dark-mode ? #212834 : #ecf1f7;
    property <color> border-col: root.dark-mode ? #364050 : #c6d0dc;
    property <color> text-primary: root.dark-mode ? #eef2f8 : #121822;
    property <color> text-secondary: root.dark-mode ? #9ca8ba : #525f72;
    property <color> accent-col: #0e74d0;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. شريط القوائم القياسي + شريط البحث السريع
        Rectangle {
            height: 32px;
            background: root.header-bg;
            border-width: 1px;
            border-color: root.border-col;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                Button {
                    text: root.arabic ? "ملف: ➕ جديد" : "File: + New";
                    clicked => { root.open-add-window(); }
                }
                Button {
                    text: root.arabic ? "التنزيلات: التفاصيل" : "Downloads: Details";
                    enabled: root.selected-task-id != "";
                    clicked => { root.open-details-window(root.selected-task-id); }
                }
                Button {
                    text: root.arabic ? "عرض: اللوحة الجانبية" : "View: Sidebar";
                    clicked => {
                        root.show-sidebar = !root.show-sidebar;
                        root.persist-ui-preferences();
                    }
                }
                Button {
                    text: root.arabic ? "أدوات: المجدول" : "Tools: Scheduler";
                    clicked => { root.open-scheduler-window(); }
                }
                Button {
                    text: root.arabic ? "أدوات: الإعدادات" : "Tools: Settings";
                    clicked => { root.open-settings-window(0); }
                }
                Button {
                    text: root.arabic ? "مساعدة: التشخيص" : "Help: Diagnostics";
                    clicked => { root.open-diagnostics-window(); }
                }

                Rectangle { horizontal-stretch: 1; }

                LineEdit {
                    width: 210px;
                    placeholder-text: root.arabic ? "🔍 بحث بالاسم أو الرابط أو الفئة..." : "🔍 Search name, URL, category...";
                    text <=> root.search-text;
                }

                Button {
                    text: root.dark-mode ? "☀️" : "🌙";
                    clicked => {
                        root.dark-mode = !root.dark-mode;
                        root.persist-ui-preferences();
                    }
                }
                Button {
                    text: root.arabic ? "EN" : "عربي";
                    clicked => {
                        root.arabic = !root.arabic;
                        root.persist-ui-preferences();
                    }
                }
            }
        }

        // 2. شريط الأدوات الرئيسي (Main Toolbar)
        if root.show-toolbar: Rectangle {
            height: 52px;
            background: root.panel-bg;
            border-width: 1px;
            border-color: root.border-col;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 5px;

                Button {
                    text: root.arabic ? "➕ تنزيل جديد" : "➕ New Download";
                    primary: true;
                    clicked => { root.open-add-window(); }
                }
                Button {
                    text: root.arabic ? "📦 دفعة أنماط" : "📦 Batch";
                    clicked => { root.show-batch-modal = true; }
                }
                Button {
                    text: root.arabic ? "▶ بدء / استئناف" : "▶ Resume";
                    enabled: root.selected-task-id != "" && (root.selected-state-code == 1 || root.selected-state-code == 3);
                    clicked => { root.control-task(root.selected-task-id, "resume"); }
                }
                Button {
                    text: root.arabic ? "⏸ إيقاف مؤقت" : "⏸ Pause";
                    enabled: root.selected-task-id != "" && (root.selected-state-code == 0 || root.selected-state-code == 5);
                    clicked => { root.control-task(root.selected-task-id, "pause"); }
                }
                Button {
                    text: root.arabic ? "⏹ إلغاء" : "⏹ Cancel";
                    enabled: root.selected-task-id != "" && root.selected-state-code != 2 && root.selected-state-code != 4;
                    clicked => {
                        root.confirm-title = root.arabic ? "تأكيد إلغاء التنزيل" : "Confirm Cancel Download";
                        root.confirm-message = root.arabic ? "هل تريد بالتأكيد إلغاء التنزيل المحدد وإيقاف اتصالاته؟" : "Cancel the selected download?";
                        root.confirm-action-kind = "cancel_task";
                        root.confirm-target-id = root.selected-task-id;
                        root.show-confirm-modal = true;
                    }
                }
                Button {
                    text: root.arabic ? "🔄 إعادة محاولة" : "🔄 Retry";
                    enabled: root.selected-task-id != "" && (root.selected-state-code == 3 || root.selected-state-code == 4);
                    clicked => { root.redownload-task(root.selected-task-id); }
                }
                Button {
                    text: root.arabic ? "🗑 حذف السجل" : "🗑 Remove Record";
                    enabled: root.selected-task-id != "";
                    clicked => {
                        root.confirm-title = root.arabic ? "حذف سجل التنزيل فقط" : "Remove Task Record Only";
                        root.confirm-message = root.arabic ? "سيتم إزالة السجل من القائمة فقط مع الحفاظ على الملف النهائي على القرص." : "Remove task record while keeping the file on disk.";
                        root.confirm-action-kind = "remove_record";
                        root.confirm-target-id = root.selected-task-id;
                        root.show-confirm-modal = true;
                    }
                }
                Button {
                    text: root.arabic ? "🧹 مسح المكتمل" : "🧹 Clear Done";
                    clicked => {
                        root.confirm-title = root.arabic ? "مسح سجلات المهام المكتملة" : "Clear Completed Records";
                        root.confirm-message = root.arabic ? "سيتم مسح سجلات المهام المكتملة من القائمة مع الحفاظ التام على جميع الملفات على القرص." : "Clear completed records while keeping all files on disk.";
                        root.confirm-action-kind = "clear_completed";
                        root.show-confirm-modal = true;
                    }
                }
                Button {
                    text: root.arabic ? "⏰ المجدول" : "⏰ Scheduler";
                    clicked => { root.open-scheduler-window(); }
                }
                Button {
                    text: root.arabic ? "⚙ الإعدادات" : "⚙ Settings";
                    clicked => { root.open-settings-window(0); }
                }
                Button {
                    text: root.arabic ? "🗜 فاحص ZIP" : "🗜 ZIP Preview";
                    clicked => { root.show-zip-modal = true; }
                }
                Button {
                    text: root.game-mode-active ? (root.arabic ? "🎮 وضع الألعاب (نشط)" : "🎮 Game Mode (ON)") : (root.arabic ? "🎮 وضع الألعاب" : "🎮 Game Mode");
                    primary: root.game-mode-active;
                    clicked => { root.toggle-game-mode(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // 3. المنطقة الوسطى: اللوحة الجانبية + جدول التنزيلات
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            if root.show-sidebar: Rectangle {
                width: 195px;
                background: root.panel-bg;
                border-width: 1px;
                border-color: root.border-col;

                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;

                    Text {
                        text: root.arabic ? "📂 التصنيفات والحالات" : "📂 Categories & Status";
                        color: root.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: root.arabic ? right : left;
                    }

                    Button { text: root.arabic ? "جميع التنزيلات" : "All Downloads"; primary: root.active-filter == "all"; clicked => { root.active-filter = "all"; root.filter-changed("all"); } }
                    Button { text: root.arabic ? "⚡ النشطة" : "⚡ Active"; primary: root.active-filter == "active"; clicked => { root.active-filter = "active"; root.filter-changed("active"); } }
                    Button { text: root.arabic ? "⏸ المتوقفة مؤقتاً" : "⏸ Paused"; primary: root.active-filter == "paused"; clicked => { root.active-filter = "paused"; root.filter-changed("paused"); } }
                    Button { text: root.arabic ? "✅ المكتملة" : "✅ Completed"; primary: root.active-filter == "completed"; clicked => { root.active-filter = "completed"; root.filter-changed("completed"); } }
                    Button { text: root.arabic ? "❌ الفاشلة" : "❌ Failed"; primary: root.active-filter == "failed"; clicked => { root.active-filter = "failed"; root.filter-changed("failed"); } }
                    Button { text: root.arabic ? "🎬 الفيديو والوسائط" : "🎬 Video & Media"; primary: root.active-filter == "video"; clicked => { root.active-filter = "video"; root.filter-changed("video"); } }
                    Button { text: root.arabic ? "🗜 المضغوطات" : "🗜 Compressed"; primary: root.active-filter == "compressed"; clicked => { root.active-filter = "compressed"; root.filter-changed("compressed"); } }
                    Button { text: root.arabic ? "💻 البرامج" : "💻 Programs"; primary: root.active-filter == "programs"; clicked => { root.active-filter = "programs"; root.filter-changed("programs"); } }
                    Button { text: root.arabic ? "📄 المستندات" : "📄 Documents"; primary: root.active-filter == "documents"; clicked => { root.active-filter = "documents"; root.filter-changed("documents"); } }
                    Button { text: root.arabic ? "🎵 الموسيقى" : "🎵 Music"; primary: root.active-filter == "music"; clicked => { root.active-filter = "music"; root.filter-changed("music"); } }

                    Rectangle { vertical-stretch: 1; }

                    Button {
                        text: root.arabic ? "🚀 تشغيل الطابور" : "🚀 Start Queue";
                        clicked => { root.resume-all-tasks(); }
                    }
                    Button {
                        text: root.arabic ? "⏹ إيقاف الكل" : "⏹ Pause All";
                        clicked => { root.stop-all-tasks(); }
                    }
                }
            }

            // جدول المهام والفاحص السفلي
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // ترويسة الجدول (تتضمن جميع الأعمدة الأساسية)
                Rectangle {
                    height: 30px;
                    background: root.header-bg;
                    border-width: 1px;
                    border-color: root.border-col;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        Text { width: 220px; text: root.arabic ? "اسم الملف" : "File Name"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 85px; text: root.arabic ? "الحجم" : "Total Size"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 85px; text: root.arabic ? "تم تنزيله" : "Downloaded"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 135px; text: root.arabic ? "الحالة والتقدم" : "Status & Progress"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 95px; text: root.arabic ? "السرعة" : "Speed"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 80px; text: root.arabic ? "المتبقي" : "ETA"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { width: 65px; text: root.arabic ? "الاتصالات" : "Conns"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: root.arabic ? "الفئة / التاريخ" : "Category / Added"; color: root.text-primary; font-weight: 700; vertical-alignment: center; }
                    }
                }

                // صفوف جدول التنزيلات مع دعم النقر بالزر الأيمن (Context Menu)
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 2px;
                        padding: 4px;

                        if root.downloads.length == 0: Rectangle {
                            height: 220px;
                            TouchArea {
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        root.context-menu-mode = 1;
                                        root.context-menu-x = self.mouse-x + 210px;
                                        root.context-menu-y = self.mouse-y + 110px;
                                        root.show-context-menu = true;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text {
                                    text: root.arabic ? "لا توجد تنزيلات مطابقة في القائمة حالياً" : "No downloads in the current view";
                                    color: root.text-secondary;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        for row in root.downloads: Rectangle {
                            height: 38px;
                            border-radius: 4px;
                            background: row.task-id == root.selected-task-id
                                ? (root.dark-mode ? #1a4e8a : #cde8ff)
                                : (root.dark-mode ? #1b2029 : #ffffff);
                            border-width: 1px;
                            border-color: row.task-id == root.selected-task-id ? root.accent-col : root.border-col;

                            TouchArea {
                                clicked => {
                                    root.selected-task-id = row.task-id;
                                    root.selected-state-code = row.state-code;
                                    root.selected-file-exists = row.file-exists;
                                    root.show-context-menu = false;
                                    root.select-task(row.task-id);
                                }
                                double-clicked => {
                                    root.selected-task-id = row.task-id;
                                    root.selected-state-code = row.state-code;
                                    root.selected-file-exists = row.file-exists;
                                    root.open-details-window(row.task-id);
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        root.selected-task-id = row.task-id;
                                        root.selected-state-code = row.state-code;
                                        root.selected-file-exists = row.file-exists;
                                        root.select-task(row.task-id);
                                        root.context-menu-mode = 0;
                                        root.context-menu-x = clamp(self.mouse-x + 200px, 20px, root.width - 260px);
                                        root.context-menu-y = clamp(self.mouse-y + 120px, 60px, root.height - 260px);
                                        root.show-context-menu = true;
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                Text {
                                    width: 220px;
                                    text: row.filename;
                                    color: root.text-primary;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 85px;
                                    text: row.size-text;
                                    color: root.text-secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 85px;
                                    text: row.downloaded-text;
                                    color: root.text-primary;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    width: 135px;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: row.status-text;
                                        font-size: 11px;
                                        color: row.state-code == 2 ? #2ec46c : row.state-code == 0 ? #40a8f5 : row.state-code == 3 ? #ee5252 : row.state-code == 4 ? #9ca3af : #f0b034;
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.dark-mode ? #0f172a : #e2e8f0;
                                        Rectangle {
                                            x: row.indeterminate ? parent.width * 0.25 : 0px;
                                            y: 0px;
                                            height: parent.height;
                                            width: row.indeterminate ? parent.width * 0.45 : parent.width * clamp(row.progress-pct / 100.0, 0.0, 1.0);
                                            border-radius: 3px;
                                            background: row.state-code == 2 ? #2ec46c : #0e74d0;
                                        }
                                    }
                                }
                                Text {
                                    width: 95px;
                                    text: row.speed-text;
                                    color: root.text-primary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 80px;
                                    text: row.eta-text;
                                    color: root.text-secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 65px;
                                    text: row.active-conns + "/" + row.segments-count;
                                    color: root.text-secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: row.category + " | " + row.created-at-text;
                                    color: root.text-secondary;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "🗗";
                                    clicked => {
                                        root.selected-task-id = row.task-id;
                                        root.open-details-window(row.task-id);
                                    }
                                }
                                Button {
                                    text: "📂";
                                    clicked => { root.open-task-folder(row.task-id); }
                                }
                            }
                        }
                    }
                }

                // لوحة الفحص السفلية
                if root.show-bottom-inspector: Rectangle {
                    height: 125px;
                    background: root.panel-bg;
                    border-width: 1px;
                    border-color: root.border-col;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: (root.arabic ? "🔍 فحص المهمة المحددة: " : "🔍 Selected Task: ") + root.selected-filename;
                                color: root.text-primary;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: root.arabic ? "🗗 فتح في نافذة تفاصيل مستقلة" : "🗗 Open Independent Details Window";
                                enabled: root.selected-task-id != "";
                                clicked => { root.open-details-window(root.selected-task-id); }
                            }
                            Button {
                                text: root.arabic ? "✔ إعادة فحص البصمات" : "✔ Re-verify Checksums";
                                enabled: root.selected-task-id != "" && root.selected-state-code == 2;
                                clicked => { root.reverify-checksum(root.selected-task-id); }
                            }
                        }

                        Rectangle {
                            height: 12px;
                            border-radius: 4px;
                            background: root.dark-mode ? #0f172a : #e2e8f0;
                            border-width: 1px;
                            border-color: root.border-col;
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                height: parent.height;
                                width: parent.width * clamp(root.selected-progress, 0.0, 1.0);
                                border-radius: 4px;
                                background: #0e74d0;
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Text { text: "SHA-256: " + root.selected-sha256; color: root.text-secondary; font-size: 11px; overflow: elide; }
                            Text { text: "MD5: " + root.selected-md5; color: root.text-secondary; font-size: 11px; }
                            Text { text: "CRC32: " + root.selected-crc32; color: root.text-secondary; font-size: 11px; }
                        }

                        Text {
                            text: root.selected-logs;
                            color: root.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // 4. شريط الحالة السفلي (Status Bar)
        if root.show-status-bar: Rectangle {
            height: 28px;
            background: root.header-bg;
            border-width: 1px;
            border-color: root.border-col;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;

                Text {
                    text: "● المحرك متصل";
                    color: #2ec46c;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: (root.arabic ? "النشطة: " : "Active: ") + root.active-count + (root.arabic ? " | الانتظار: " : " | Queued: ") + root.queued-count + (root.arabic ? " | السرعة: " : " | Speed: ") + root.aggregate-speed-text;
                    color: root.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.tools-badge-text;
                    color: #40a8f5;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.status-banner;
                    color: root.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ========================================================================
    // القائمة السياقية المنبثقة الذكية عند النقر بالزر الأيمن (Right-Click Menu)
    // ========================================================================
    if root.show-context-menu: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000022;

        TouchArea {
            clicked => { root.show-context-menu = false; }
        }

        Rectangle {
            x: root.context-menu-x;
            y: root.context-menu-y;
            width: 245px;
            background: root.panel-bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.border-col;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                if root.context-menu-mode == 1: VerticalLayout {
                    spacing: 4px;
                    Button { text: root.arabic ? "➕ إضافة تنزيل جديد..." : "➕ Add New Download..."; clicked => { root.show-context-menu = false; root.open-add-window(); } }
                    Button { text: root.arabic ? "📦 إضافة دفعة أنماط..." : "📦 Add Batch..."; clicked => { root.show-context-menu = false; root.show-batch-modal = true; } }
                    Button { text: root.arabic ? "↺ مسح البحث والمرشح" : "↺ Clear Filter & Search"; clicked => { root.show-context-menu = false; root.search-text = ""; root.active-filter = "all"; root.filter-changed("all"); } }
                }

                if root.context-menu-mode == 0: VerticalLayout {
                    spacing: 4px;
                    Text { text: root.selected-filename; color: root.text-primary; font-weight: 700; overflow: elide; }

                    // أوامر المكتمل
                    if root.selected-state-code == 2: Button {
                        text: root.selected-file-exists ? (root.arabic ? "📂 فتح الملف" : "📂 Open File") : (root.arabic ? "⚠ الملف مفقود من القرص" : "⚠ File Missing");
                        enabled: root.selected-file-exists;
                        clicked => { root.show-context-menu = false; root.open-task-file(root.selected-task-id); }
                    }
                    Button {
                        text: root.arabic ? "📁 فتح المجلد المحتوي على الملف" : "📁 Open Containing Folder";
                        clicked => { root.show-context-menu = false; root.open-task-folder(root.selected-task-id); }
                    }

                    // أوامر النشط
                    if root.selected-state-code == 0 || root.selected-state-code == 5: Button {
                        text: root.arabic ? "⏸ إيقاف مؤقت" : "⏸ Pause Download";
                        clicked => { root.show-context-menu = false; root.control-task(root.selected-task-id, "pause"); }
                    }

                    // أوامر المتوقف أو الفاشل
                    if root.selected-state-code == 1 || root.selected-state-code == 3: Button {
                        text: root.arabic ? "▶ استئناف / إعادة المحاولة" : "▶ Resume / Retry";
                        clicked => { root.show-context-menu = false; root.control-task(root.selected-task-id, "resume"); }
                    }

                    // إلغاء غير المكتمل
                    if root.selected-state-code != 2 && root.selected-state-code != 4: Button {
                        text: root.arabic ? "⏹ إلغاء التنزيل" : "⏹ Cancel Download";
                        clicked => {
                            root.show-context-menu = false;
                            root.confirm-title = root.arabic ? "تأكيد إلغاء التنزيل" : "Confirm Cancel";
                            root.confirm-message = root.arabic ? "هل تريد إيقاف وإلغاء التنزيل المحدد؟" : "Cancel selected download?";
                            root.confirm-action-kind = "cancel_task";
                            root.confirm-target-id = root.selected-task-id;
                            root.show-confirm-modal = true;
                        }
                    }

                    Button {
                        text: root.arabic ? "🔁 إعادة التحميل من البداية" : "🔁 Restart from Beginning";
                        clicked => { root.show-context-menu = false; root.redownload-task(root.selected-task-id); }
                    }
                    Button {
                        text: root.arabic ? "📋 نسخ رابط المصدر" : "📋 Copy Source URL";
                        clicked => { root.show-context-menu = false; root.copy-to-clipboard(root.selected-url); }
                    }
                    Button {
                        text: root.arabic ? "🎬 معاينة أثناء التحميل (Play Preview)" : "🎬 Play Preview While Downloading";
                        clicked => { root.show-context-menu = false; root.preview-task(root.selected-task-id); }
                    }
                    if root.selected-state-code == 3: Button {
                        text: root.arabic ? "🩺 تشخيص العطل الذكي (Download Doctor)" : "🩺 Diagnose Failure (Download Doctor)";
                        clicked => { root.show-context-menu = false; root.diagnose-task(root.selected-task-id); }
                    }
                    Button {
                        text: root.arabic ? "🗗 عرض التفاصيل المستقلة..." : "🗗 View Details Window...";
                        clicked => { root.show-context-menu = false; root.open-details-window(root.selected-task-id); }
                    }
                    Button {
                        text: root.arabic ? "🗑 حذف سجل التنزيل فقط" : "🗑 Remove Record Only";
                        clicked => {
                            root.show-context-menu = false;
                            root.confirm-title = root.arabic ? "حذف سجل التنزيل فقط" : "Remove Record Only";
                            root.confirm-message = root.arabic ? "سيتم حذف السجل من القائمة فقط مع بقاء الملف على القرص." : "Remove record only; keep file on disk.";
                            root.confirm-action-kind = "remove_record";
                            root.confirm-target-id = root.selected-task-id;
                            root.show-confirm-modal = true;
                        }
                    }
                    Button {
                        text: root.arabic ? "🔥 حذف السجل والملف من القرص..." : "🔥 Delete Record & File from Disk...";
                        clicked => {
                            root.show-context-menu = false;
                            root.confirm-title = root.arabic ? "⚠ تحذير: حذف الملف نهائياً من القرص" : "⚠ Delete File from Disk";
                            root.confirm-message = root.arabic ? "سيتم حذف سجل المهمة وحذف الملف الفعلي نهائياً من القرص الصلب!" : "Permanently delete both record and file from disk!";
                            root.confirm-action-kind = "delete_disk";
                            root.confirm-target-id = root.selected-task-id;
                            root.show-confirm-modal = true;
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // حوار التأكيد قبل العمليات المدمرة (Confirmation Modal)
    // ========================================================================
    if root.show-confirm-modal: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;

        Rectangle {
            width: 460px;
            height: 190px;
            background: root.panel-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-col;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.confirm-title;
                    color: root.confirm-action-kind == "delete_disk" ? #ee5252 : root.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.confirm-message;
                    color: root.text-secondary;
                    font-size: 13px;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: root.arabic ? "✔ تأكيد التنفيذ" : "✔ Confirm";
                        primary: true;
                        clicked => {
                            if (root.confirm-action-kind == "remove_record") {
                                root.remove-task(root.confirm-target-id, false);
                            } else if (root.confirm-action-kind == "delete_disk") {
                                root.remove-task(root.confirm-target-id, true);
                            } else if (root.confirm-action-kind == "clear_completed") {
                                root.delete-completed-tasks();
                            } else if (root.confirm-action-kind == "cancel_task") {
                                root.control-task(root.confirm-target-id, "cancel");
                            }
                            root.show-confirm-modal = false;
                        }
                    }
                    Button {
                        text: root.arabic ? "إلغاء الأمر" : "Cancel";
                        clicked => { root.show-confirm-modal = false; }
                    }
                }
            }
        }
    }

    // نافذة التنزيل الدفعي (Wildcard Batch Expander)
    if root.show-batch-modal: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;

        Rectangle {
            width: 520px;
            height: 230px;
            background: root.panel-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-col;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: root.arabic ? "📦 التنزيل الدفعي وتوسيع الأنماط [001-120:2]" : "📦 Wildcard Batch Download";
                    color: root.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }
                LineEdit {
                    placeholder-text: "https://cdn.example.com/part_[001-020:1].rar";
                    text <=> root.batch-pattern-input;
                }
                LineEdit {
                    placeholder-text: root.arabic ? "مقدار الخطوة (Step): 1" : "Step: 1";
                    text <=> root.batch-step-input;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.arabic ? "إغلاق" : "Close";
                        clicked => { root.show-batch-modal = false; }
                    }
                    Button {
                        text: root.arabic ? "توسيع وجدولة الروابط" : "Expand & Queue";
                        primary: true;
                        clicked => {
                            root.add-batch(root.batch-pattern-input, root.batch-step-input);
                            root.show-batch-modal = false;
                        }
                    }
                }
            }
        }
    }

    // نافذة معاينة محتويات ZIP عن بُعد عبر HTTP Range
    if root.show-zip-modal: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;

        Rectangle {
            width: 620px;
            height: 380px;
            background: root.panel-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-col;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: root.arabic ? "🗜 فاحص محتويات أرشيفات ZIP عن بُعد (HTTP Range Central Directory)" : "🗜 Remote ZIP Archive Inspector";
                    color: root.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "https://example.com/archive.zip";
                        text <=> root.zip-url-input;
                    }
                    Button {
                        text: root.arabic ? "فحص الأرشيف" : "Inspect ZIP";
                        primary: true;
                        clicked => { root.inspect-remote-zip(root.zip-url-input); }
                    }
                }
                Text {
                    text: root.zip-summary-text;
                    color: root.text-secondary;
                    font-size: 12px;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 3px;
                        for entry in root.zip-entries: HorizontalLayout {
                            spacing: 10px;
                            Text { width: 280px; text: entry.filename; color: root.text-primary; overflow: elide; }
                            Text { width: 100px; text: entry.uncompressed-size; color: root.text-secondary; }
                            Text { horizontal-stretch: 1; text: "CRC32: " + entry.crc32-hex; color: root.text-secondary; }
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.arabic ? "إغلاق" : "Close";
                        clicked => { root.show-zip-modal = false; }
                    }
                }
            }
        }
    }
}
