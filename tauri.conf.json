{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustIDM Studio",
  "version": "1.1.0",
  "identifier": "com.rustidm.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RustIDM Studio v1.1.0",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "id": "rustidm-tray",
      "iconPath": "icons/icon.png",
      "menuOnLeftClick": false,
      "tooltip": "RustIDM Studio — محرك التنزيل نشط"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:16888; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
